{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "description": "E2E testing i debugowanie UI"
    },
    "sqlite": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "walldecor.db"
      ],
      "description": "Inspekcja bazy SQLite podczas development"
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"],
      "description": "Live błędy Next.js, routes, Server Actions"
    }
  }
}
