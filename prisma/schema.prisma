generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── M1 Core Models ──────────────────────────────────────────────────────────

model CostCenter {
  id          String  @id
  name        String
  description String?

  budgetEntries    BudgetEntry[]
  actualEntries    ActualEntry[]
  revenues         Revenue[]
  revenueBudgets   RevenueBudget[]
  areaRevenues     AreaRevenue[]
  employees        Employee[]
  paymentReminders PaymentReminder[]
  budgetThresholds BudgetThreshold[]
  ksefInvoices     KsefInvoice[]
  ksefSupplierRules KsefSupplierRule[]
  ksefInvoicePartAllocations KsefInvoicePartAllocation[]
  costEventPartAllocations   CostEventPartAllocation[]
  contributionMarginSettings ContributionMarginSetting[]
}

model AccountCategory {
  id            String        @id @default(cuid())
  name          String        @unique
  order         Int
  subCategories SubCategory[]
}

model SubCategory {
  id         String          @id @default(cuid())
  name       String
  order      Int
  categoryId String
  isFixed    Boolean         @default(false)
  category   AccountCategory @relation(fields: [categoryId], references: [id])

  budgetEntries    BudgetEntry[]
  actualEntries    ActualEntry[]
  budgetThresholds BudgetThreshold[]
  ksefInvoices     KsefInvoice[]
  ksefSupplierRules KsefSupplierRule[]
}

// Role: ADMIN | MANAGER | EMPLOYEE
model User {
  id                 String    @id @default(cuid())
  username           String?   @unique
  email              String    @unique
  name               String
  role               String    @default("EMPLOYEE")
  passwordHash       String
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  isActive           Boolean   @default(true)
  employeeId         String?   @unique
  employee           Employee? @relation(fields: [employeeId], references: [id])
  createdAt          DateTime  @default(now())

  visibilityGrants        ContentVisibilityGrant[] @relation("VisibilityGrantUser")
  grantedVisibilityGrants ContentVisibilityGrant[] @relation("VisibilityGrantGrantedBy")
}

// ─── Finance Models ───────────────────────────────────────────────────────────

model BudgetEntry {
  id            String      @id @default(cuid())
  year          Int
  month         Int
  amount        Float
  costCenterId  String
  costCenter    CostCenter  @relation(fields: [costCenterId], references: [id])
  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])

  @@unique([year, month, costCenterId, subCategoryId])
}

model ActualEntry {
  id            String      @id @default(cuid())
  year          Int
  month         Int
  amount        Float
  costCenterId  String
  costCenter    CostCenter  @relation(fields: [costCenterId], references: [id])
  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])

  @@unique([year, month, costCenterId, subCategoryId])
}

// channel: SALON | MONTAZ | ECOMMERCE
model RevenueBudget {
  id           String     @id @default(cuid())
  year         Int
  month        Int
  amount       Float
  costCenterId String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id])
  channel      String

  @@unique([year, month, costCenterId, channel])
}

// channel: SALON | MONTAZ | ECOMMERCE
model Revenue {
  id           String     @id @default(cuid())
  year         Int
  month        Int
  amount       Float
  costCenterId String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id])
  channel      String

  @@unique([year, month, costCenterId, channel])
}

model AreaRevenue {
  id           String     @id @default(cuid())
  year         Int
  month        Int
  amount       Float
  costCenterId String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id])
  areaTagId    String
  areaTag      CostTag    @relation(fields: [areaTagId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([year, month, costCenterId, areaTagId])
  @@index([year, month])
  @@index([costCenterId])
  @@index([areaTagId])
}

model CashAccount {
  id        String               @id @default(cuid())
  name      String
  currency  String               @default("PLN")
  type      String               @default("bank")
  balance   Float                @default(0)
  order     Int                  @default(0)
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  history   CashBalanceHistory[]
}

model CashBalanceHistory {
  id              String      @id @default(cuid())
  accountId       String
  account         CashAccount @relation(fields: [accountId], references: [id])
  previousBalance Float
  newBalance      Float
  changedBy       String
  createdAt       DateTime    @default(now())
}

model ReceivableEntry {
  id         String   @id @default(cuid())
  clientName String?
  amount     Float
  dueDate    DateTime
  status     String   @default("PENDING")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CashLiabilitySnapshot {
  id        String   @id @default(cuid())
  amount    Float
  date      DateTime @default(now())
  notes     String?
  createdBy String
  createdAt DateTime @default(now())
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model KsefInvoice {
  id            String   @id @default(cuid())
  source        String   @default("MANUAL")
  externalId    String?  @unique
  supplierName  String
  supplierNip   String?
  invoiceNumber String
  issueDate     DateTime
  grossAmount   Float
  netAmount     Float?
  vatAmount     Float?
  currency      String   @default("PLN")
  reportingGrossAmount Float?
  reportingNetAmount   Float?
  reportingVatAmount   Float?
  originalCurrency     String?
  originalGrossAmount  Float?
  originalNetAmount    Float?
  originalVatAmount    Float?
  currencyConversionNote String?
  convertedById String?
  convertedAt   DateTime?
  status        String   @default("NEW")
  paymentStatus String   @default("UNPAID")
  paidAt        DateTime?
  dueDate       DateTime?
  bankAccount   String?
  paymentDetailsFetchedAt DateTime?
  xmlContent    String?
  xmlFetchedAt  DateTime?
  documentStatus String  @default("ACTIVE")
  ruleMatchStatus String @default("NO_RULE")
  correctsInvoiceId String?
  correctsInvoice   KsefInvoice? @relation("KsefCorrection", fields: [correctsInvoiceId], references: [id])
  corrections       KsefInvoice[] @relation("KsefCorrection")
  notes         String?
  actualEntryId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])
  subCategoryId String?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])
  supplierRuleId String?
  supplierRule   KsefSupplierRule? @relation(fields: [supplierRuleId], references: [id])

  costEvent CostEvent?
  parts     KsefInvoicePart[]
  auditLogs CostAuditLog[]

  @@index([status])
  @@index([paymentStatus])
  @@index([documentStatus])
  @@index([ruleMatchStatus])
  @@index([correctsInvoiceId])
  @@index([dueDate])
  @@index([bankAccount])
  @@index([issueDate])
  @@index([supplierNip])
  @@unique([supplierNip, invoiceNumber, issueDate])
}

model KsefSupplierRule {
  id                  String   @id @default(cuid())
  supplierNamePattern String?
  supplierNip         String?
  priority            Int      @default(100)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  costCenterId  String
  costCenter    CostCenter  @relation(fields: [costCenterId], references: [id])
  subCategoryId String?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])
  invoices      KsefInvoice[]
  tags          KsefSupplierRuleTag[]

  @@index([active])
  @@index([supplierNip])
  @@index([priority])
}

model CostTagGroup {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  order     Int       @default(0)
  tags      CostTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model CostTag {
  id        String       @id @default(cuid())
  groupId   String
  group     CostTagGroup @relation(fields: [groupId], references: [id])
  name      String
  slug      String       @unique
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  invoiceParts  KsefInvoicePartTag[]
  eventParts    CostEventPartTag[]
  supplierRules KsefSupplierRuleTag[]
  areaRevenues  AreaRevenue[]
}

model KsefSupplierRuleTag {
  id     String @id @default(cuid())
  ruleId String
  rule   KsefSupplierRule @relation(fields: [ruleId], references: [id])
  tagId  String
  tag    CostTag @relation(fields: [tagId], references: [id])

  @@unique([ruleId, tagId])
}

model KsefInvoicePart {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     KsefInvoice @relation(fields: [invoiceId], references: [id])
  label       String
  grossAmount Float
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags        KsefInvoicePartTag[]
  allocations KsefInvoicePartAllocation[]
}

model KsefInvoicePartTag {
  id     String @id @default(cuid())
  partId String
  part   KsefInvoicePart @relation(fields: [partId], references: [id])
  tagId  String
  tag    CostTag @relation(fields: [tagId], references: [id])

  @@unique([partId, tagId])
}

model KsefInvoicePartAllocation {
  id           String @id @default(cuid())
  partId       String
  part         KsefInvoicePart @relation(fields: [partId], references: [id])
  costCenterId String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id])
  percent      Float

  @@unique([partId, costCenterId])
}

model CostEvent {
  id              String   @id @default(cuid())
  source          String
  sourceInvoiceId String?  @unique
  sourceInvoice   KsefInvoice? @relation(fields: [sourceInvoiceId], references: [id])
  eventDate       DateTime
  supplierName    String?
  supplierNip     String?
  reference       String?
  grossAmount     Float
  netAmount       Float?
  vatAmount       Float?
  currency        String   @default("PLN")
  status          String   @default("APPROVED")
  documentStatus  String   @default("ACTIVE")
  isConfidential  Boolean  @default(false)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parts     CostEventPart[]
  auditLogs CostAuditLog[]

  @@index([eventDate])
  @@index([status])
  @@index([supplierNip])
  @@index([isConfidential])
}

model CostEventPart {
  id          String   @id @default(cuid())
  eventId     String
  event       CostEvent @relation(fields: [eventId], references: [id])
  label       String
  grossAmount Float
  order       Int      @default(0)

  tags        CostEventPartTag[]
  allocations CostEventPartAllocation[]
}

model CostEventPartTag {
  id     String @id @default(cuid())
  partId String
  part   CostEventPart @relation(fields: [partId], references: [id])
  tagId  String
  tag    CostTag @relation(fields: [tagId], references: [id])

  @@unique([partId, tagId])
}

model CostEventPartAllocation {
  id           String @id @default(cuid())
  partId       String
  part         CostEventPart @relation(fields: [partId], references: [id])
  costCenterId String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id])
  percent      Float
  fallbackUsed Boolean @default(false)

  @@unique([partId, costCenterId])
}

model CostAuditLog {
  id          String   @id @default(cuid())
  invoiceId   String?
  invoice     KsefInvoice? @relation(fields: [invoiceId], references: [id])
  costEventId String?
  costEvent   CostEvent? @relation(fields: [costEventId], references: [id])
  action      String
  actorId     String?
  beforeJson  String?
  afterJson   String?
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@index([costEventId])
  @@index([createdAt])
}

model FinancePeriodClose {
  id         String   @id @default(cuid())
  year       Int
  month      Int
  source     String   @default("MANUAL")
  closedById String?
  closedAt   DateTime @default(now())
  note       String?

  @@unique([year, month])
}

model ContributionMarginSetting {
  id            String   @id @default(cuid())
  costCenterId  String
  costCenter    CostCenter @relation(fields: [costCenterId], references: [id])
  margin        Float
  effectiveFrom DateTime
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([costCenterId, effectiveFrom])
}

model PaymentReminder {
  id                String     @id @default(cuid())
  name              String
  amount            Float
  dayOfMonth        Int
  costCenterId      String
  costCenter        CostCenter @relation(fields: [costCenterId], references: [id])
  active            Boolean    @default(true)
  alertDaysInAdvance Int       @default(3)
  lastAlertedDate   String?
  createdAt         DateTime   @default(now())
}

model BudgetThreshold {
  id              String   @id @default(cuid())
  name            String
  warningPercent  Int      @default(80)
  criticalPercent Int      @default(100)
  costCenterId    String?
  subCategoryId   String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  costCenter  CostCenter?  @relation(fields: [costCenterId], references: [id])
  subCategory SubCategory? @relation(fields: [subCategoryId], references: [id])
}

// ─── HR Models ────────────────────────────────────────────────────────────────

// costCenterId: JAG | PUL | GLOBAL
model Employee {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String     @unique
  phone        String?
  position     String
  costCenterId String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id])
  startDate    DateTime
  endDate      DateTime?
  active       Boolean    @default(true)
  userId       String?    @unique
  user         User?

  // New HR fields
  employmentType String?   // "UoP" | "B2B" | "UZ" | "UoD" | "inne"
  avatarUrl      String?
  divisionId     String?
  division       Division?   @relation(fields: [divisionId], references: [id])
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  teamId         String?
  team           Team?       @relation(fields: [teamId], references: [id])
  positionId     String?
  positionRef    Position?   @relation(fields: [positionId], references: [id])
  managerId      String?
  manager        Employee?   @relation("ManagerRelation", fields: [managerId], references: [id])
  subordinates   Employee[]  @relation("ManagerRelation")

  // Existing relations
  contracts           Contract[]
  additionalContracts AdditionalContract[]
  salaryHistory       SalaryHistory[]
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  workTimeRecords     WorkTimeRecord[]

  // New time tracking + leave relations
  timeEntries       TimeEntry[]
  workSchedules     WorkSchedule[]
  overtimeRequests  OvertimeRequest[]
  leaveBalancesNew  LeaveBalanceNew[]
  leaveRequestsNew  LeaveRequestNew[]

  installationOrdersPrimary InstallationOrder[]      @relation("InstallationOrderPrimaryEmployee")
  installationOrdersBackup  InstallationOrder[]      @relation("InstallationOrderBackupEmployee")
  installationDelegations   InstallationDelegation[]
  installationOrderAssignments InstallationOrderInstaller[]

  createdAt DateTime @default(now())
}

// ─── Installation Operations ─────────────────────────────────────────────────

model InstallationClient {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  order     InstallationOrder?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstallationOrder {
  id                    String   @id @default(cuid())
  number                String   @unique
  status                String   @default("DRAFT")
  clientId              String   @unique
  client                InstallationClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  addressStreet         String
  addressBuildingNumber String?
  addressApartmentNumber String?
  addressPostalCode     String
  addressCity           String
  primaryEmployeeId     String
  primaryEmployee       Employee @relation("InstallationOrderPrimaryEmployee", fields: [primaryEmployeeId], references: [id], onDelete: Restrict)
  backupEmployeeId      String
  backupEmployee        Employee @relation("InstallationOrderBackupEmployee", fields: [backupEmployeeId], references: [id], onDelete: Restrict)
  scheduledAt           DateTime?
  externalSystem        String?
  externalId            String?
  archivedAt            DateTime?
  delegations           InstallationDelegation[]
  installerAssignments  InstallationOrderInstaller[]
  auditEvents           InstallationAuditEvent[]
  formSnapshots         InstallationOrderFormSnapshot[]
  clientLinks           InstallationClientLink[]
  formSubmissions       InstallationFormSubmission[]
  clarifications        InstallationClarification[]
  rooms                 InstallationRoom[]
  visitFeePolicyId      String?
  visitFeePolicy        InstallationVisitFeePolicy? @relation("InstallationOrderVisitFeePolicy", fields: [visitFeePolicyId], references: [id], onDelete: Restrict)
  visitFeeStatus        String   @default("NONE")
  visitFeeGrossAmount   Decimal?
  visitFeeClauseText    String?
  visitFeeClauseVersion Int?
  visitFeeLegalApprovedAt DateTime?
  visitFeeSelectedById  String?
  visitFeeSelectedAt    DateTime?
  visitFeeOverrideReason String?
  visitFeeApprovedById  String?
  visitFeeApprovedAt    DateTime?
  visitFeeClientAcceptedAt DateTime?
  visitFeeClientIpHash  String?
  visitFeeClientUserAgent String?
  mismatches            InstallationMismatch[]
  billingTasks          InstallationBillingTask[]
  files                 InstallationFile[]
  mismatchEvidenceFiles InstallationMismatchEvidence[]
  mobileUploadHandoffs  MobileUploadHandoff[]
  fileAuditEvents       InstallationFileAuditEvent[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status, archivedAt])
  @@index([primaryEmployeeId])
  @@index([backupEmployeeId])
  @@index([visitFeeStatus])
}

/// Versioned company wording; rows are retained because every order stores a legal snapshot.
model InstallationVisitFeePolicy {
  id              String   @id @default(cuid())
  version         Int      @unique
  grossAmount     Decimal
  clauseText      String
  legalApprovedAt DateTime?
  legalApprovedById String?
  isDefault       Boolean  @default(false)
  archivedAt      DateTime?
  createdById     String?
  orders          InstallationOrder[] @relation("InstallationOrderVisitFeePolicy")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isDefault, archivedAt])
  @@index([legalApprovedAt])
}

/// A field report is intentionally separate from billing: finance is only enabled by an explicit approval.
model InstallationMismatch {
  id                      String   @id @default(cuid())
  orderId                 String
  order                   InstallationOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  description             String
  reason                  String
  evidenceReference       String
  evidenceStatus          String   @default("PENDING_PRIVATE_FILE")
  evidenceFileId          String?
  evidenceVerifiedAt      DateTime?
  reportedById            String
  reportedAt              DateTime @default(now())
  coordinatorApprovedById String?
  coordinatorApprovedAt   DateTime?
  approvalNote            String?
  billingTask             InstallationBillingTask?
  evidenceAttachment      InstallationMismatchEvidence?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([orderId, reportedAt])
  @@index([coordinatorApprovedAt])
  @@index([evidenceStatus])
}

/// Foundation for Task 10; creation from a mismatch is DB-guarded and never automatic.
model InstallationBillingTask {
  id              String   @id @default(cuid())
  orderId         String
  order           InstallationOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  mismatchId      String?  @unique
  mismatch        InstallationMismatch? @relation(fields: [mismatchId], references: [id], onDelete: Restrict)
  kind            String
  status          String   @default("PENDING")
  grossAmount     Decimal
  description     String
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId, status])
}

model InstallationOrderInstaller {
  id          String            @id @default(cuid())
  orderId     String
  order       InstallationOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  employeeId  String
  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdById String?
  createdAt   DateTime          @default(now())

  @@unique([orderId, employeeId])
  @@index([employeeId])
}

model InstallationDelegation {
  id                 String   @id @default(cuid())
  orderId            String
  order              InstallationOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  delegateEmployeeId String
  delegateEmployee   Employee @relation(fields: [delegateEmployeeId], references: [id], onDelete: Restrict)
  startsAt           DateTime
  endsAt             DateTime?
  endedAt            DateTime?
  reason             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([orderId, startsAt])
  @@index([delegateEmployeeId])
}

model InstallationAuditEvent {
  id           String   @id @default(cuid())
  orderId      String
  order        InstallationOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId      String
  action       String
  beforeJson   String?
  afterJson    String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([actorId])
}

model InstallationCatalogCategory {
  id         String                    @id @default(cuid())
  name       String
  nameKey    String                    @unique
  sortOrder  Int                       @default(0)
  isActive   Boolean                   @default(true)
  archivedAt DateTime?
  types      InstallationCatalogType[]
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  @@index([isActive, sortOrder])
}

model InstallationCatalogType {
  id         String                       @id @default(cuid())
  categoryId String
  category   InstallationCatalogCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name       String
  nameKey    String
  sortOrder  Int                          @default(0)
  isActive   Boolean                      @default(true)
  archivedAt DateTime?
  products   InstallationCatalogProduct[]
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt

  @@unique([categoryId, nameKey])
  @@index([categoryId, isActive, sortOrder])
}

model InstallationCatalogProduct {
  id           String                    @id @default(cuid())
  typeId       String
  type         InstallationCatalogType   @relation(fields: [typeId], references: [id], onDelete: Restrict)
  name         String
  nameKey      String
  manufacturer String?
  collection   String?
  code         String?
  sortOrder    Int                       @default(0)
  isActive     Boolean                   @default(true)
  archivedAt   DateTime?
  scopeProducts InstallationScopeProduct[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([typeId, nameKey])
  @@index([typeId, isActive, sortOrder])
}

model InstallationFormTemplate {
  id                  String                           @id @default(cuid())
  familyId            String
  name                String
  nameKey             String
  version             Int
  status              String                           @default("DRAFT")
  publishedAt         DateTime?
  createdById         String?
  questionDefinitions InstallationQuestionDefinition[]
  formSnapshots       InstallationOrderFormSnapshot[]
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  @@unique([familyId, version])
  @@index([nameKey, status])
  @@index([familyId, status])
}

model InstallationQuestionDefinition {
  id            String                   @id @default(cuid())
  templateId    String
  template      InstallationFormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  key           String
  type          String
  label         String
  help          String?
  required      Boolean                  @default(false)
  riskLevel     String                   @default("LOW")
  optionsJson   String?
  conditionJson String?
  sortOrder     Int                      @default(0)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([templateId, key])
  @@index([templateId, sortOrder])
}

model InstallationOrderFormSnapshot {
  id              String                   @id @default(cuid())
  orderId         String                   @unique
  order           InstallationOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  templateId      String
  template        InstallationFormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion Int
  schemaJson      String
  createdById     String?
  submissions     InstallationFormSubmission[]
  createdAt       DateTime                 @default(now())

  @@index([templateId, templateVersion])
}

model InstallationClientLink {
  id           String            @id @default(cuid())
  orderId      String
  order        InstallationOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  tokenHash    String            @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  sentAt       DateTime?
  sentById     String?
  createdById  String
  createdAt    DateTime          @default(now())
  lastOpenedAt DateTime?
  files        InstallationFile[] @relation("InstallationFileClientLink")
  mobileUploadHandoffs MobileUploadHandoff[]

  @@index([orderId, expiresAt])
  @@index([orderId, revokedAt])
  @@index([orderId, sentAt])
}

model InstallationFormSubmission {
  id             String                          @id @default(cuid())
  orderId        String
  order          InstallationOrder               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  formSnapshotId String
  formSnapshot   InstallationOrderFormSnapshot   @relation(fields: [formSnapshotId], references: [id], onDelete: Restrict)
  revisionOfId   String?
  revisionOf     InstallationFormSubmission?     @relation("InstallationSubmissionCorrections", fields: [revisionOfId], references: [id], onDelete: Restrict)
  corrections    InstallationFormSubmission[]    @relation("InstallationSubmissionCorrections")
  revisionNumber Int
  status         String                          @default("DRAFT")
  draftKey       String?                         @unique
  draftVersion   Int                             @default(0)
  submittedAt    DateTime?
  answers        InstallationAnswer[]
  mutations      InstallationFormSubmissionMutation[]
  clarifications InstallationClarification[]
  files          InstallationFile[] @relation("InstallationFileSubmission")
  mobileUploadHandoffs MobileUploadHandoff[]
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt

  @@unique([orderId, revisionNumber])
  @@index([orderId, status, createdAt])
  @@index([revisionOfId])
}

model InstallationAnswer {
  id              String                     @id @default(cuid())
  submissionId    String
  submission      InstallationFormSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  questionKey     String
  questionType    String
  valueJson       String
  normalizedValue String
  isUnknown       Boolean                    @default(false)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([submissionId, questionKey])
  @@index([submissionId, isUnknown])
}

model InstallationFormSubmissionMutation {
  id               String                     @id @default(cuid())
  submissionId     String
  submission       InstallationFormSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  draftVersion     Int
  clientMutationId String
  operation        String
  responseJson     String
  createdAt        DateTime                   @default(now())

  @@unique([submissionId, draftVersion, clientMutationId])
  @@index([submissionId, createdAt])
}

model InstallationClarification {
  id                 String                     @id @default(cuid())
  orderId            String
  order              InstallationOrder          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sourceSubmissionId String
  sourceSubmission   InstallationFormSubmission @relation(fields: [sourceSubmissionId], references: [id], onDelete: Restrict)
  questionKey        String
  reasonCode         String
  reason             String
  isBlocking         Boolean                    @default(true)
  status             String                     @default("OPEN")
  resolution         String?
  resolutionNote     String?
  evidenceReference  String?
  resolvedById       String?
  resolvedAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([sourceSubmissionId, questionKey, reasonCode])
  @@index([orderId, status, isBlocking])
  @@index([sourceSubmissionId])
}

/// Private-media metadata only. File bytes live exclusively in the separate
/// media service; this record is the app's authorization and audit boundary.
model InstallationFile {
  id                String   @id
  orderId           String
  order             InstallationOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  roomId            String?
  room              InstallationRoom? @relation("InstallationFileRoom", fields: [roomId], references: [id], onDelete: Restrict)
  scopeId           String?
  scope             InstallationScope? @relation("InstallationFileScope", fields: [scopeId], references: [id], onDelete: Restrict)
  formSubmissionId  String?
  formSubmission    InstallationFormSubmission? @relation("InstallationFileSubmission", fields: [formSubmissionId], references: [id], onDelete: Restrict)
  clientLinkId      String?
  clientLink        InstallationClientLink? @relation("InstallationFileClientLink", fields: [clientLinkId], references: [id], onDelete: Restrict)
  mobileHandoffId   String?
  mobileHandoff     MobileUploadHandoff? @relation(fields: [mobileHandoffId], references: [id], onDelete: Restrict)
  purpose           String
  questionKey       String?
  originalFilename  String
  contentType       String
  byteSize          Int?
  sha256            String?
  status            String   @default("PENDING")
  failureReason     String?
  source            String   @default("WEB")
  createdById       String?
  softDeletedAt     DateTime?
  softDeletedById   String?
  remoteDeleteStatus       String   @default("NOT_REQUESTED")
  remoteDeleteAttemptCount Int      @default(0)
  remoteDeleteLastError    String?
  remoteDeleteNextAttemptAt DateTime?
  remoteDeletedAt          DateTime?
  mismatchEvidence  InstallationMismatchEvidence?
  auditEvents       InstallationFileAuditEvent[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orderId, purpose, questionKey, status, softDeletedAt])
  @@index([roomId, createdAt])
  @@index([scopeId, createdAt])
  @@index([formSubmissionId, questionKey])
  @@index([clientLinkId, questionKey])
  @@index([mobileHandoffId])
  @@index([remoteDeleteStatus, remoteDeleteNextAttemptAt])
}

/// A single, immutable link between a reported mismatch and the private file
/// that proves it. Database guards verify order, target and READY state.
model InstallationMismatchEvidence {
  id           String   @id @default(cuid())
  orderId      String
  order        InstallationOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  mismatchId   String   @unique
  mismatch     InstallationMismatch @relation(fields: [mismatchId], references: [id], onDelete: Restrict)
  fileId       String   @unique
  file         InstallationFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  attachedById String
  attachedAt   DateTime @default(now())

  @@index([orderId, fileId])
}

/// One-time QR handoff. Both QR and mobile-session secrets are stored only as
/// SHA-256 hashes; the phone can add files but never enumerate or download.
model MobileUploadHandoff {
  id                String   @id @default(cuid())
  orderId           String
  order             InstallationOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  clientLinkId      String
  clientLink        InstallationClientLink @relation(fields: [clientLinkId], references: [id], onDelete: Restrict)
  formSubmissionId  String
  formSubmission    InstallationFormSubmission @relation(fields: [formSubmissionId], references: [id], onDelete: Restrict)
  questionKey       String
  codeHash          String   @unique
  sessionSecretHash String?  @unique
  allowedMimeJson   String
  maxFiles          Int      @default(5)
  usedFiles         Int      @default(0)
  maxByteSize       Int      @default(10485760)
  expiresAt         DateTime
  redeemedAt        DateTime?
  revokedAt         DateTime?
  files             InstallationFile[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([clientLinkId, expiresAt, revokedAt])
  @@index([orderId, questionKey])
}

model InstallationFileAuditEvent {
  id           String   @id @default(cuid())
  fileId       String
  file         InstallationFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  orderId      String
  order        InstallationOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId      String
  action       String
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([fileId, createdAt])
  @@index([orderId, createdAt])
}

model InstallationRoom {
  id           String                   @id @default(cuid())
  orderId      String
  order        InstallationOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  name         String
  sortOrder    Int                      @default(0)
  scopes       InstallationScope[]
  measurements InstallationMeasurement[]
  files        InstallationFile[]        @relation("InstallationFileRoom")
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([orderId, sortOrder])
}

model InstallationScope {
  id           String                     @id @default(cuid())
  roomId       String
  room         InstallationRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int                        @default(0)
  scopeProducts InstallationScopeProduct[]
  measurements InstallationMeasurement[]
  files        InstallationFile[]          @relation("InstallationFileScope")
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@index([roomId, sortOrder])
}

model InstallationScopeProduct {
  id                          String                      @id @default(cuid())
  scopeId                     String
  scope                       InstallationScope           @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  catalogProductId            String
  catalogProduct              InstallationCatalogProduct  @relation(fields: [catalogProductId], references: [id], onDelete: Restrict)
  productNameSnapshot         String
  productCodeSnapshot         String?
  manufacturerSnapshot        String?
  collectionSnapshot          String?
  sortOrder                   Int                         @default(0)
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  @@index([scopeId, sortOrder])
  @@index([catalogProductId])
}

model InstallationMeasurement {
  id            String             @id @default(cuid())
  roomId        String
  room          InstallationRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  scopeId       String?
  scope         InstallationScope? @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  elementName   String
  value         Decimal
  unit          String
  source        String
  authorId      String?
  authorContext String?
  actorUserId   String?
  actorRole     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([roomId, createdAt])
  @@index([scopeId, createdAt])
  @@index([actorUserId, createdAt])
}

// type: UOP | B2B | UZ
model Contract {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  type       String
  startDate  DateTime
  endDate    DateTime?
  salary     Float
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

// type: UOP | B2B | UZ
model AdditionalContract {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  description String
  type        String
  amount      Float
  startDate   DateTime
  endDate     DateTime?
  active      Boolean   @default(true)
}

model SalaryHistory {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  amount        Float
  effectiveFrom DateTime
  notes         String?
  createdAt     DateTime @default(now())
}

// type: VACATION | SICK | CARE | OTHER
// status: PENDING | APPROVED | REJECTED
model LeaveRequest {
