generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── M1 Core Models ──────────────────────────────────────────────────────────

model CostCenter {
  id          String  @id
  name        String
  description String?

  budgetEntries    BudgetEntry[]
  actualEntries    ActualEntry[]
  revenues         Revenue[]
  revenueBudgets   RevenueBudget[]
  employees        Employee[]
  paymentReminders PaymentReminder[]
  budgetThresholds BudgetThreshold[]
}

model AccountCategory {
  id            String        @id @default(cuid())
  name          String        @unique
  order         Int
  subCategories SubCategory[]
}

model SubCategory {
  id         String          @id @default(cuid())
  name       String
  order      Int
  categoryId String
  isFixed    Boolean         @default(false)
  category   AccountCategory @relation(fields: [categoryId], references: [id])

  budgetEntries    BudgetEntry[]
  actualEntries    ActualEntry[]
  budgetThresholds BudgetThreshold[]
}

// Role: ADMIN | MANAGER | EMPLOYEE
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         String    @default("EMPLOYEE")
  passwordHash String
  isActive     Boolean   @default(true)
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime  @default(now())
}

// ─── Finance Models ───────────────────────────────────────────────────────────

model BudgetEntry {
  id            String      @id @default(cuid())
  year          Int
  month         Int
  amount        Float
  costCenterId  String
  costCenter    CostCenter  @relation(fields: [costCenterId], references: [id])
  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])

  @@unique([year, month, costCenterId, subCategoryId])
}

model ActualEntry {
  id            String      @id @default(cuid())
  year          Int
  month         Int
  amount        Float
  costCenterId  String
  costCenter    CostCenter  @relation(fields: [costCenterId], references: [id])
  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])

  @@unique([year, month, costCenterId, subCategoryId])
}

// channel: SALON | MONTAZ | ECOMMERCE
model RevenueBudget {
  id           String     @id @default(cuid())
  year         Int
  month        Int
  amount       Float
  costCenterId String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id])
  channel      String

  @@unique([year, month, costCenterId, channel])
}

// channel: SALON | MONTAZ | ECOMMERCE
model Revenue {
  id           String     @id @default(cuid())
  year         Int
  month        Int
  amount       Float
  costCenterId String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id])
  channel      String

  @@unique([year, month, costCenterId, channel])
}

model CashAccount {
  id        String               @id @default(cuid())
  name      String
  currency  String               @default("PLN")
  type      String               @default("bank")
  balance   Float                @default(0)
  order     Int                  @default(0)
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  history   CashBalanceHistory[]
}

model CashBalanceHistory {
  id              String      @id @default(cuid())
  accountId       String
  account         CashAccount @relation(fields: [accountId], references: [id])
  previousBalance Float
  newBalance      Float
  changedBy       String
  createdAt       DateTime    @default(now())
}

model ReceivableEntry {
  id         String   @id @default(cuid())
  clientName String?
  amount     Float
  dueDate    DateTime
  status     String   @default("PENDING")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CashLiabilitySnapshot {
  id        String   @id @default(cuid())
  amount    Float
  date      DateTime @default(now())
  notes     String?
  createdBy String
  createdAt DateTime @default(now())
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PaymentReminder {
  id                String     @id @default(cuid())
  name              String
  amount            Float
  dayOfMonth        Int
  costCenterId      String
  costCenter        CostCenter @relation(fields: [costCenterId], references: [id])
  active            Boolean    @default(true)
  alertDaysInAdvance Int       @default(3)
  lastAlertedDate   String?
  createdAt         DateTime   @default(now())
}

model BudgetThreshold {
  id              String   @id @default(cuid())
  name            String
  warningPercent  Int      @default(80)
  criticalPercent Int      @default(100)
  costCenterId    String?
  subCategoryId   String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  costCenter  CostCenter?  @relation(fields: [costCenterId], references: [id])
  subCategory SubCategory? @relation(fields: [subCategoryId], references: [id])
}

// ─── HR Models ────────────────────────────────────────────────────────────────

// costCenterId: JAG | PUL | GLOBAL
model Employee {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String     @unique
  phone        String?
  position     String
  costCenterId String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id])
  startDate    DateTime
  endDate      DateTime?
  active       Boolean    @default(true)
  userId       String?    @unique
  user         User?

  // New HR fields
  employmentType String?   // "UoP" | "B2B" | "UZ" | "UoD" | "inne"
  avatarUrl      String?
  divisionId     String?
  division       Division?   @relation(fields: [divisionId], references: [id])
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  teamId         String?
  team           Team?       @relation(fields: [teamId], references: [id])
  positionId     String?
  positionRef    Position?   @relation(fields: [positionId], references: [id])
  managerId      String?
  manager        Employee?   @relation("ManagerRelation", fields: [managerId], references: [id])
  subordinates   Employee[]  @relation("ManagerRelation")

  // Existing relations
  contracts           Contract[]
  additionalContracts AdditionalContract[]
  salaryHistory       SalaryHistory[]
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  workTimeRecords     WorkTimeRecord[]

  // New time tracking + leave relations
  timeEntries       TimeEntry[]
  workSchedules     WorkSchedule[]
  overtimeRequests  OvertimeRequest[]
  leaveBalancesNew  LeaveBalanceNew[]
  leaveRequestsNew  LeaveRequestNew[]

  createdAt DateTime @default(now())
}

// type: UOP | B2B | UZ
model Contract {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  type       String
  startDate  DateTime
  endDate    DateTime?
  salary     Float
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

// type: UOP | B2B | UZ
model AdditionalContract {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  description String
  type        String
  amount      Float
  startDate   DateTime
  endDate     DateTime?
  active      Boolean   @default(true)
}

model SalaryHistory {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  amount        Float
  effectiveFrom DateTime
  notes         String?
  createdAt     DateTime @default(now())
}

// type: VACATION | SICK | CARE | OTHER
// status: PENDING | APPROVED | REJECTED
model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String
  startDate  DateTime
  endDate    DateTime
  days       Int
  status     String   @default("PENDING")
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// type: VACATION | SICK | CARE | OTHER
model LeaveBalance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  year       Int
  type       String
  total      Int
  used       Int      @default(0)

  @@unique([employeeId, year, type])
}

model WorkTimeRecord {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  date          DateTime
  startTime     String
  endTime       String
  regularHours  Float
  overtimeHours Float    @default(0)
  note          String?

  @@unique([employeeId, date])
}

// ─── HR Org Structure ─────────────────────────────────────────────────────────

model Division {
  id           String     @id @default(cuid())
  name         String
  costCenterId String?    // "JAG" | "PUL" | "GLOBAL" — powiązanie z istniejącym systemem
  employees    Employee[]
  departments  Department[]
  timeRules    TimeTrackingRule[]
  holidays     CustomHoliday[]
  createdAt    DateTime   @default(now())
}

model Department {
  id         String     @id @default(cuid())
  name       String
  divisionId String
  division   Division   @relation(fields: [divisionId], references: [id])
  employees  Employee[]
  teams      Team[]
}

model Team {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  employees    Employee[]
}

model Position {
  id        String     @id @default(cuid())
  name      String
  employees Employee[]
}

// ─── HR Time Tracking ─────────────────────────────────────────────────────────

model TimeEntry {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  date            DateTime
  clockIn         DateTime
  clockOut        DateTime?
  breaks          Break[]
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id])
  taskName        String?
  source          String    @default("manual") // "manual" | "auto" | "clock" | "bulk"
  status          String    @default("pending") // "pending" | "approved" | "rejected"
  approvedById    String?
  notes           String?
  totalMinutes    Int?
  breakMinutes    Int?
  overtimeMinutes Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([employeeId, date])
}

model Break {
  id          String    @id @default(cuid())
  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime?
  type        String    @default("break") // "break" | "lunch" | "other"
}

model Project {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  isActive    Boolean     @default(true)
  timeEntries TimeEntry[]
}

model WorkSchedule {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  date         DateTime
  startTime    String   // "08:00"
  endTime      String   // "16:00"
  breakMinutes Int      @default(30)
  type         String   @default("regular") // "regular" | "overtime" | "on-call"
  isTemplate   Boolean  @default(false)
  templateName String?

  @@unique([employeeId, date])
}

model TimeTrackingRule {
  id                String   @id @default(cuid())
  divisionId        String
  division          Division @relation(fields: [divisionId], references: [id])
  name              String
  dailyHours        Float    @default(8)
  weeklyHours       Float    @default(40)
  breakAfterHours   Float    @default(6)
  breakMinutes      Int      @default(15)
  roundingRule      String   @default("none") // "none" | "15min" | "30min"
  overtimeThreshold Float    @default(8)
  periodType        String   @default("monthly") // "monthly" | "weekly" | "quarterly"
  periodStart       Int      @default(1)
}

model BillingPeriod {
  id         String    @id @default(cuid())
  name       String
  startDate  DateTime
  endDate    DateTime
  status     String    @default("open") // "open" | "closed" | "locked"
  closedAt   DateTime?
  closedById String?
  createdAt  DateTime  @default(now())
}

model OvertimeRequest {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  date         DateTime
  minutes      Int
  reason       String
  status       String    @default("pending") // "pending" | "approved" | "rejected"
  resolution   String?   // "time_off" | "payment" — set on approval
  rejectionNote String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── HR Leave Types ───────────────────────────────────────────────────────────

model LeaveType {
  id               String        @id @default(cuid())
  name             String
  code             String        @unique
  color            String        @default("#3B82F6")
  isPaid           Boolean       @default(true)
  requiresApproval Boolean       @default(true)
  maxDaysPerYear   Int?
  isActive         Boolean       @default(true)
  parentId         String?
  parent           LeaveType?    @relation("LeaveSubtype", fields: [parentId], references: [id])
  subtypes         LeaveType[]   @relation("LeaveSubtype")
  leaveBalancesNew LeaveBalanceNew[]
  leaveRequestsNew LeaveRequestNew[]
}

model LeaveBalanceNew {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  totalDays   Float
  usedDays    Float     @default(0)
  pendingDays Float     @default(0)
  carriedOver Float     @default(0)

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequestNew {
  id               String    @id @default(cuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId      String
  leaveType        LeaveType @relation(fields: [leaveTypeId], references: [id])
  startDate        DateTime
  endDate          DateTime
  days             Float
  hours            Float?
  isOnDemand       Boolean   @default(false)
  isRemoteWork     Boolean   @default(false)
  isDelegation     Boolean   @default(false)
  status           String    @default("pending") // "pending" | "approved" | "rejected" | "cancelled"
  approverId       String?
  approvedAt       DateTime?
  rejectionNote    String?
  substituteId     String?
  notifySubstitute Boolean   @default(false)
  note             String?
  attachments      String?   // JSON array
  gcalEventId      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model CustomHoliday {
  id          String    @id @default(cuid())
  name        String
  date        DateTime
  divisionId  String?
  division    Division? @relation(fields: [divisionId], references: [id])
  isRecurring Boolean   @default(false)
  country     String    @default("PL")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "leave_request" | "leave_approved" | "overtime" | etc.
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
