# Database
DATABASE_URL="file:/data/walldecor.db"
# Application startup only: true skips seed after backup and migrate deploy.
# Requires an existing non-empty database with successful migration history and
# no unresolved failed migration. Unset/false keeps seed mandatory; only literal
# true/false are accepted. Keep false for a fresh installation.
WALLDECOR_SKIP_SEED=false

# NextAuth Configuration
NEXTAUTH_URL="https://app.walldecor.pl"
NEXTAUTH_SECRET="your-generated-secret-here"

# Optional installation-form client IP evidence. Leave the header blank until
# the Coolify ingress is configured to REMOVE every client-supplied copy and
# overwrite it with exactly one normalized client IP (for example:
# X-WallDecor-Client-IP). Ordinary X-Forwarded-For/X-Real-IP are ignored.
INSTALLATION_TRUSTED_CLIENT_IP_HEADER=""
# Optional dedicated HMAC secret. When omitted, production uses NEXTAUTH_SECRET.
# Never reuse or commit the example value as a real secret.
INSTALLATION_IP_HASH_SECRET=""

# Private installation media service. It must be reachable only from the
# application network; never expose this URL or bearer token to a browser.
INSTALLATION_MEDIA_API_URL="http://walldecor-private-media:3000"
INSTALLATION_MEDIA_API_TOKEN=""
# Whole-operation timeout in milliseconds, including the complete download body.
INSTALLATION_MEDIA_TIMEOUT_MS="15000"

# Default Admin User
ADMIN_EMAIL="piotr.lesniewski@walldecor.pl"
ADMIN_PASSWORD="your-secure-password-here"

# Node Environment
NODE_ENV="production"

# Shared private AI queue. Same dedicated random credential (at least 32 ASCII
# characters) only in the app and isolated worker. Never a NEXT_PUBLIC variable.
# No OpenAI/Anthropic API key or automatic paid-provider fallback is used.
AI_WORKER_SECRET=""
# Worker-only settings. Keep disabled until Linux boundary and owner OAuth gates.
AI_WORKER_ENABLED=false
AI_WORKER_URL="http://walldecor-app:3000/api/internal/ai-worker"

# Private invoice originals on the application persistent volume. These must be
# distinct canonical absolute paths with an existing trusted parent. Never use
# public/ or NEXT_PUBLIC settings. Both directories must be private (mode 0700).
INVOICE_ORIGINALS_DIR="/data/invoice-originals"
INVOICE_PROCESSING_DIR="/data/invoice-processing"
INVOICE_PDFINFO_BINARY="/usr/bin/pdfinfo"
INVOICE_PDFTOPPM_BINARY="/usr/bin/pdftoppm"

# API key for n8n/automation import
IMPORT_API_KEY="your-secure-random-key-here"

# n8n webhook URL for Google Calendar integration (leave approval sync)
N8N_WEBHOOK_URL="https://larry229-20229.mikrus.cloud/webhook/walldecor-leave-approved"

# Installation visit Calendar synchronization. Configure real credentials only
# in Coolify; never commit them or enter them in the browser application.
INSTALLATION_CALENDAR_ENABLED=false
INSTALLATION_CALENDAR_ADAPTER=disabled
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_IMPERSONATED_USER=info@walldecor.pl
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON_B64=
INSTALLATION_CALENDAR_WORKER_BATCH_SIZE=20
